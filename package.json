{
  "name": "ffxiv-timer",
  "version": "0.2.0",
  "description": "FFXIV timers.",
  "main": "clock.js",
  "private": true,
  "scripts": {
    "build:tools": "tsc --build tsconfig.tools.json",
    "scrape": "pnpm run build:tools && node ./build-plugins/lib/run-tool.mjs",
    "prepare": "pnpm run scrape && vite build --emptyOutDir",
    "preview": "pnpm run prepare && vite preview",
    "start": "pnpm run scrape && vite",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xenoveritas/js-timer.git"
  },
  "keywords": [
    "timer",
    "clock"
  ],
  "author": "Xenoveritas",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Xenoveritas/js-timer/issues"
  },
  "homepage": "https://github.com/Xenoveritas/js-timer#readme",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cheerio": "^1.0.0-rc.12",
    "dayjs": "^1.11.13",
    "sass": "^1.30.0",
    "typescript": "^5.5.4",
    "vite": "^6.0.6"
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b"
}
